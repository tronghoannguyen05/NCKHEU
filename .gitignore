# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Data downloaded or derived from third-party sources: regenerate with the pipeline.
# The hand-coded rollout dataset in data/rollout/ IS tracked.
data/raw/*
data/interim/*
data/processed/*
!data/raw/README.md
!data/interim/.gitkeep
!data/processed/.gitkeep

# Outputs: regenerate. Commit final tables deliberately with `git add -f`.
output/tables/*
output/figures/*
output/honestdid/*
output/*.md
!output/tables/.gitkeep
!output/figures/.gitkeep
!output/honestdid/.gitkeep

# OS / editors
.DS_Store
.vscode/
.idea/
